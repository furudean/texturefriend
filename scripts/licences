#!/usr/bin/env python3

import argparse
import json
import re
import runpy
import sys
import tomllib
from importlib import metadata
from pathlib import Path

app_info = runpy.run_path(str(Path(__file__).parent / "app-info"))

ROOT: Path = app_info["ROOT"]

EXTRAS = ROOT / "packaging" / "licences.toml"
LICENCES = ROOT / "texturefriend" / "assets" / "licences"
INDEX = LICENCES / "index.toml"


def normalize(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def homepage(meta: metadata.PackageMetadata) -> str:
    for url in meta.get_all("Project-URL") or []:
        label, _, link = url.partition(",")
        if label.strip().lower() == "homepage":
            return link.strip()

    return meta.get("Home-page") or ""


def entry(package: str) -> dict[str, str]:
    name = normalize(package)

    try:
        meta = metadata.metadata(name)
    except metadata.PackageNotFoundError:
        sys.exit(f"{package} is not installed")

    # older packages put the spdx expression in the free text licence field
    licence = meta.get("License-Expression") or meta.get("License")
    if not licence:
        sys.exit(f"{package} declares no licence")

    return {
        "name": meta["Name"],
        "licence": licence,
        "homepage": homepage(meta),
        "file": f"{name}.txt",
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="fail if the licence list is out of date")
    args = parser.parse_args()

    extras = tomllib.loads(EXTRAS.read_text(encoding="utf-8"))

    entries = sorted([*map(entry, extras["packages"]), *extras.get("license", [])], key=lambda e: e["name"].lower())

    missing = [e["file"] for e in entries if not (LICENCES / e["file"]).exists()]
    if missing:
        sys.exit(f"add the licence text to {LICENCES} for {', '.join(missing)}")

    lines = []
    for e in entries:
        lines.append("[[license]]")
        lines.extend(f"{key} = {json.dumps(e[key])}" for key in ("name", "licence", "homepage", "file"))
        lines.append("")

    index = "\n".join(lines).rstrip() + "\n"

    if args.check:
        if not INDEX.exists() or INDEX.read_text(encoding="utf-8") != index:
            sys.exit(f"{INDEX} is out of date, run poe licences")

        print(f"{len(entries)} licences are up to date")
        return

    INDEX.write_text(index, encoding="utf-8")
    print(f"wrote {len(entries)} licences to {INDEX}")


if __name__ == "__main__":
    main()
